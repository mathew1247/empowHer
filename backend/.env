# ─────────────────────────────────────────────────────────
#  EmpowHer Backend — Environment Variables
#  Copy this file to .env and fill in your actual values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────

# Flask secret key (generate a strong random string for production)
SECRET_KEY=empowher-super-secret-key-change-me-in-production

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:empower123@localhost:5432/empowher_db

# JWT secret key (generate a strong random string for production)
JWT_SECRET_KEY=empowher-jwt-secret-key-change-me-in-production

# App environment: development | production
FLASK_ENV=development
FLASK_DEBUG=True
